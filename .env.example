# ─────────────────────────────────────────────────────────────
# Saathi HRMS — environment template. Copy to `.env` and fill in.
# No value here is a real secret. Secrets live only in `.env`/vault,
# never committed. The system runs fully on-prem; the only outbound
# dependency is the LLM adapter (mock by default in development).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Postgres (pgvector image). Matches docker-compose.yml.
POSTGRES_USER=saathi
POSTGRES_PASSWORD=saathi_dev_pw
POSTGRES_DB=saathi
DATABASE_URL=postgresql://saathi:saathi_dev_pw@localhost:5432/saathi?schema=public

# Keycloak (console OIDC). Matches docker-compose.yml + infra/keycloak realm.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=saathi
KEYCLOAK_CLIENT_ID=saathi-web
KEYCLOAK_CLIENT_SECRET=saathi-web-dev-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# API
API_PORT=4000
# Signs the web session cookie. Generate a real random value for any shared env.
SESSION_SECRET=change-me-dev-only-session-secret

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# LLM gateway. Phase 0 default is the offline mock model.
# Options: mock | claude | onprem   (claude/onprem are stubbed adapters)
LLM_PROVIDER=mock
# Only used when LLM_PROVIDER=claude (not required in Phase 0):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Only used when LLM_PROVIDER=onprem:
ONPREM_LLM_URL=

# Field-level encryption key for PII tokenization (32-byte base64 in real envs).
PII_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!
