{
  "realm": "saathi",
  "enabled": true,
  "displayName": "Saathi HRMS",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Any regular employee — read own data" },
      { "name": "hr_officer", "description": "HR console operator" },
      { "name": "manager", "description": "Reporting/approving officer" },
      { "name": "payroll_head", "description": "Locks payroll runs" },
      { "name": "safety_officer", "description": "Can override contract gate blocks" },
      { "name": "admin", "description": "System administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "saathi-web",
      "name": "Saathi Web Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "saathi-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:4000/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:4000"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "empCode",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "empCode",
            "claim.name": "empCode",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "unit",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "unit",
            "claim.name": "unit",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "dept",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "dept",
            "claim.name": "dept",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "priya.borah",
      "email": "priya.borah@nrl.example.in",
      "firstName": "Priya",
      "lastName": "Borah",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo1234", "temporary": false }],
      "realmRoles": ["employee", "hr_officer"],
      "attributes": {
        "empCode": ["E-10001"],
        "unit": ["HQ-Guwahati"],
        "dept": ["HR"]
      }
    },
    {
      "username": "arnab.saikia",
      "email": "arnab.saikia@nrl.example.in",
      "firstName": "Arnab",
      "lastName": "Saikia",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo1234", "temporary": false }],
      "realmRoles": ["employee"],
      "attributes": {
        "empCode": ["E-10002"],
        "unit": ["Hydrocracker"],
        "dept": ["Operations"]
      }
    }
  ]
}
